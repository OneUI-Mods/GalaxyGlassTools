<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/glass_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?attr/colorSurface"
  android:orientation="vertical">

  <com.google.android.material.appbar.MaterialToolbar
    android:id="@+id/glass_toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    app:title="@string/glass_title" />

  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp">

      <dev.ryuya.galaxyglass.GlassPreview
        android:id="@+id/glass_preview"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:contentDescription="@string/glass_preview" />

      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="28dp"
        app:strokeWidth="0dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="18dp">

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/glass_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/glass_enabled"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/glass_quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="@string/glass_quick"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/glass_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="@string/glass_notifications"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/glass_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="@string/glass_volume"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/glass_system_surfaces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="@string/glass_system_surfaces"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/glass_lock_screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="@string/glass_lock_screen"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/glass_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:text="@string/glass_home"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/glass_capture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/glass_capture"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />



          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:labelFor="@id/glass_strength"
              android:text="@string/glass_strength"
              android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
            <TextView
              android:id="@+id/glass_value"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
          </LinearLayout>
          <com.google.android.material.slider.Slider
            android:id="@+id/glass_strength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:labelFor="@id/glass_tint"
              android:text="@string/glass_tint"
              android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
            <TextView
              android:id="@+id/glass_tint_value"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
          </LinearLayout>
          <com.google.android.material.slider.Slider
            android:id="@+id/glass_tint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/glass_tint_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="24dp"
        app:strokeWidth="0dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/glass_system_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/glass_system_apps"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/glass_installed_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/glass_installed_apps"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

          <TextView
            android:id="@+id/glass_system_app_scope_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/glass_system_app_scope"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/glass_system_app_scope_request" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <TextView
        android:id="@+id/glass_live_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:visibility="gone" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/glass_surface_diagnostics"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/glass_surface_diagnostics"
        android:visibility="gone" />

      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="24dp"
        app:strokeWidth="0dp">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/glass_reload_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/glass_reload_home"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/glass_reload_home" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/glass_reload_capture"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/glass_reload_capture" />

          <TextView
            android:id="@+id/glass_reload_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/glass_reload_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.button.MaterialButton
        android:id="@+id/glass_licenses"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/license_title" />

      <TextView
        android:id="@+id/glass_requirements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>
